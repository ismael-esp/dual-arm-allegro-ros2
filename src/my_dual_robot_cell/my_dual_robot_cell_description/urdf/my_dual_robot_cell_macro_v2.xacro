<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- <xacro:include filename="$(find my_dual_robot_cell_control)/urdf/ur_macro.xacro"/> -->
  <xacro:include filename="$(find my_dual_robot_cell_control)/urdf/ur_macro_left.xacro"/> 
  <xacro:include filename="$(find my_dual_robot_cell_control)/urdf/ur_macro_right.xacro"/>

  <xacro:macro name="my_dual_robot_cell" params="
    parent
    *origin

    la_ur_type
    la_joint_limits_parameters_file
    la_kinematics_parameters_file
    la_physical_parameters_file
    la_visual_parameters_file

    ra_ur_type
    ra_joint_limits_parameters_file
    ra_kinematics_parameters_file
    ra_physical_parameters_file
    ra_visual_parameters_file
    ">

    <joint name="table_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="table" />
    </joint>

    <link name="table">
      <visual>
        <origin rpy="0 0 0" xyz="0 0.17 -0.375"/>
        <geometry>
          <!-- box size is x y z in meters -->
          <box size="1.20 1.09 0.75"/>
        </geometry>
        <material name="table_gray">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
      </visual>

      <collision>
        <origin rpy="0 0.0 0" xyz="0 0.17 -0.375"/>
        <geometry>
          <box size="1.20 1.09 0.75"/>
        </geometry>
      </collision>
    </link>

    <material name="white">
      <color rgba="1 1 1 1"/>
    </material>

    <!--Creates the mounts to attach the robots to the table-->
    <link name="la_robot_mount"/>
    <joint name="base_to_la_robot_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="la_robot_mount"/>
      <!-- <origin xyz="0.5 0.3 0" rpy="0 0 ${pi}" /> -->
      <origin xyz="-0.245 0.0 0.75" rpy="0 0 ${pi/2}" />
    </joint>
  
    <link name="ra_robot_mount"/>
    <joint name="base_to_ra_robot_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="ra_robot_mount"/>
      <!-- <origin xyz="1.2 0.3 0" rpy="0 0 ${pi}" /> -->
      <origin xyz="0.245 0.0 0.75" rpy="0 0 ${-pi/2}" />
    </joint>

    <!--Creates the 1st Robot-->
    <xacro:la_robot
      name="la"
      tf_prefix="la_"
      parent="la_robot_mount"
      joint_limits_parameters_file="${la_joint_limits_parameters_file}"
      kinematics_parameters_file="${la_kinematics_parameters_file}"
      physical_parameters_file="${la_physical_parameters_file}"
      visual_parameters_file="${la_visual_parameters_file}"
    >
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:la_robot>
  
    <!--Creates the 2nd Robot-->
    <xacro:ra_robot
      name="ra"
      tf_prefix="ra_"
      parent="ra_robot_mount"
      joint_limits_parameters_file="${ra_joint_limits_parameters_file}"
      kinematics_parameters_file="${ra_kinematics_parameters_file}"
      physical_parameters_file="${ra_physical_parameters_file}"
      visual_parameters_file="${ra_visual_parameters_file}"
    >
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:ra_robot>

  </xacro:macro>

</robot>
