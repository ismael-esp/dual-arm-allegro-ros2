# Upstream drivers, pinned to the exact versions this cell runs.
#   vcs import src < dual_arm.repos
#   git -C src/realsense-ros apply ../../patches/realsense-ros.patch
# (scripts/setup_workspace.sh does both.)
repositories:
  Universal_Robots_ROS2_Driver:
    type: git
    url: https://github.com/UniversalRobots/Universal_Robots_ROS2_Driver.git
    version: f7bbe922cf4c3de933aac23c54533ee47caa1470   # jazzy branch, 2025-07-29 (3.3.3)
  Universal_Robots_ROS2_Driver/ur_description:
    type: git
    url: https://github.com/UniversalRobots/Universal_Robots_ROS2_Description.git
    version: 3.2.0
  realsense-ros:
    type: git
    url: https://github.com/IntelRealSense/realsense-ros.git
    version: bafc21080c5c8e259dadbb309797949aee0dd950   # ros2-master, 2025-07-23 (4.56.x)
