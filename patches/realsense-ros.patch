new file mode 100644
index 00000000..addc7def
--- /dev/null
+++ b/table_tilt.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""
+table_tilt.py
+
+Subscribe to a depth point cloud, transform points to a target frame
+(default: world), fit the largest plane inside a configurable z-band,
+and report the plane's tilt vs. world +Z as well as its height.
+
+The tilt is a direct proxy for the residual rotation error of your
+hand-eye calibration when pointed at a known-horizontal surface
+(table top, floor, etc.).
+
+Usage:
+    python3 table_tilt.py
+    # or, once installed via setup.py:
+    ros2 run easy_handeye2 table_tilt.py
+
+Adjust the constants below for your topic / frame / table band.
+"""
+import rclpy
+from rclpy.node import Node
+from sensor_msgs.msg import PointCloud2
+import sensor_msgs_py.point_cloud2 as pc2
+import numpy as np
+import tf2_ros
+
+
+def quat_to_matrix(qx, qy, qz, qw):
+    """Quaternion (xyzw) -> 3x3 rotation matrix. Pure NumPy."""
+    n = qx * qx + qy * qy + qz * qz + qw * qw
+    if n < 1e-12:
+        return np.eye(3)
+    s = 2.0 / n
+    xx, yy, zz = qx * qx * s, qy * qy * s, qz * qz * s
+    xy, xz, yz = qx * qy * s, qx * qz * s, qy * qz * s
+    wx, wy, wz = qw * qx * s, qw * qy * s, qw * qz * s
+    return np.array([
+        [1.0 - (yy + zz), xy - wz,         xz + wy],
+        [xy + wz,         1.0 - (xx + zz), yz - wx],
+        [xz - wy,         yz + wx,         1.0 - (xx + yy)],
+    ])
+
+
+# --- adjust these to your setup ---
+TOPIC = '/extra/cam2/depth/color/points'    # aligned depth cloud
+TARGET_FRAME = 'world'
+Z_MIN, Z_MAX = 0.88, 0.95                    # world-Z band where the table top lives
+RANSAC_THRESH = 0.005                       # 5 mm
+RANSAC_ITERS = 2000
+
+
+class TableTilt(Node):
+    def __init__(self):
+        super().__init__('table_tilt')
+        self.tfb = tf2_ros.Buffer()
+        self.tfl = tf2_ros.TransformListener(self.tfb, self)
+        self.done = False
+        self.create_subscription(PointCloud2, TOPIC, self.cb, 10)
+        self.get_logger().info(f'Listening on {TOPIC}; target frame: {TARGET_FRAME}')
+
+    def cb(self, msg):
+        if self.done:
+            return
+        try:
+            t = self.tfb.lookup_transform(
+                TARGET_FRAME, msg.header.frame_id,
+                rclpy.time.Time(),
+                rclpy.duration.Duration(seconds=2.0))
+        except Exception as e:
+            self.get_logger().warn(f'TF lookup failed: {e}; will retry on next msg')
+            return
+        self.done = True
+
+        T = np.eye(4)
+        T[:3, :3] = quat_to_matrix(
+            t.transform.rotation.x, t.transform.rotation.y,
+            t.transform.rotation.z, t.transform.rotation.w)
+        T[:3, 3] = [t.transform.translation.x,
+                    t.transform.translation.y,
+                    t.transform.translation.z]
+
+        pts = np.array([(p[0], p[1], p[2]) for p in
+                        pc2.read_points(msg, field_names=['x', 'y', 'z'], skip_nans=True)],
+                       dtype=np.float64)
+        self.get_logger().info(f'Got {len(pts)} valid points')
+
+        pts_w = (T @ np.c_[pts, np.ones(len(pts))].T).T[:, :3]
+        self.get_logger().info(
+            f'World Z range:  min={pts_w[:, 2].min():.3f}  max={pts_w[:, 2].max():.3f}')
+
+        mask = (pts_w[:, 2] > Z_MIN) & (pts_w[:, 2] < Z_MAX)
+        tbl = pts_w[mask]
+        self.get_logger().info(f'Points in z-band [{Z_MIN}, {Z_MAX}]: {len(tbl)}')
+        if len(tbl) < 1000:
+            self.get_logger().error('Too few points in band - adjust Z_MIN/Z_MAX')
+            rclpy.shutdown()
+            return
+
+        rng = np.random.default_rng(42)
+        best_inl, best_plane = 0, None
+        for _ in range(RANSAC_ITERS):
+            i = rng.choice(len(tbl), 3, replace=False)
+            p1, p2, p3 = tbl[i]
+            n = np.cross(p2 - p1, p3 - p1)
+            nn = np.linalg.norm(n)
+            if nn < 1e-9:
+                continue
+            n /= nn
+            d = -n @ p1
+            inl = int((np.abs(tbl @ n + d) < RANSAC_THRESH).sum())
+            if inl > best_inl:
+                best_inl, best_plane = inl, (n, d)
+
+        n, d = best_plane
+        if n[2] < 0:
+            n, d = -n, -d
+        tilt = np.degrees(np.arccos(np.clip(n @ np.array([0, 0, 1]), -1, 1)))
+        table_z = -d
+
+        self.get_logger().info('=== RESULT ===')
+        self.get_logger().info(f'  Plane normal (world): [{n[0]:+.4f} {n[1]:+.4f} {n[2]:+.4f}]')
+        self.get_logger().info(f'  Tilt vs world Z:      {tilt:.3f} degrees')
+        self.get_logger().info(f'  Table top world Z:    {table_z:.4f} m')
+        self.get_logger().info(f'  Inliers: {best_inl} / {len(tbl)}')
+        rclpy.shutdown()
+
+
+def main():
+    rclpy.init()
+    rclpy.spin(TableTilt())
+
+
+if __name__ == '__main__':
+    main()
