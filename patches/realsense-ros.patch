diff --git a/realsense2_camera/src/base_realsense_node.cpp b/realsense2_camera/src/base_realsense_node.cpp
index 84a47ba3..0c145704 100755
--- a/realsense2_camera/src/base_realsense_node.cpp
+++ b/realsense2_camera/src/base_realsense_node.cpp
@@ -19,6 +19,7 @@
 #include <rclcpp/clock.hpp>
 #include <fstream>
 #include <image_publisher.h>
+#include <yaml-cpp/yaml.h>
 
 // Header files for disabling intra-process comms for static broadcaster.
 #include <rclcpp/publisher_options.hpp>
@@ -847,6 +848,74 @@ void BaseRealSenseNode::updateStreamCalibData(const rs2::video_stream_profile& v
         _camera_info[stream_index].p.at(3) = 0;     // Tx
         _camera_info[stream_index].p.at(7) = 0;     // Ty
     }
+
+    // ---- PATCH: per-stream camera_info_url override ----
+    // Looks for a ROS parameter "<stream_name>.camera_info_url" (e.g.
+    // "color.camera_info_url"). If set to a file:// URL pointing to a
+    // standard camera_info YAML, the K, P, D and distortion_model fields
+    // are overwritten with the YAML's calibrated values. Otherwise the
+    // firmware values from librealsense are kept unchanged.
+    std::string stream_name = STREAM_NAME(stream_index);
+    std::string url_param = stream_name + ".camera_info_url";
+    std::string camera_info_url = _parameters->setParam<std::string>(url_param, std::string(""));
+    if (!camera_info_url.empty())
+    {
+        const std::string file_prefix = "file://";
+        std::string path = camera_info_url;
+        if (path.rfind(file_prefix, 0) == 0)
+            path = path.substr(file_prefix.size());
+        try
+        {
+            YAML::Node cal = YAML::LoadFile(path);
+            int yaml_w = cal["image_width"].as<int>();
+            int yaml_h = cal["image_height"].as<int>();
+            if (yaml_w != static_cast<int>(intrinsic.width) ||
+                yaml_h != static_cast<int>(intrinsic.height))
+            {
+                ROS_WARN_STREAM("camera_info_url for stream '" << stream_name
+                    << "' has resolution " << yaml_w << "x" << yaml_h
+                    << " but stream is " << intrinsic.width << "x"
+                    << intrinsic.height << " - using FIRMWARE intrinsics.");
+            }
+            else
+            {
+                auto K = cal["camera_matrix"]["data"].as<std::vector<double>>();
+                auto D = cal["distortion_coefficients"]["data"].as<std::vector<double>>();
+                auto P = cal["projection_matrix"]["data"].as<std::vector<double>>();
+                auto R = cal["rectification_matrix"]["data"].as<std::vector<double>>();
+                std::string model = cal["distortion_model"]
+                    ? cal["distortion_model"].as<std::string>() : std::string("plumb_bob");
+
+                if (K.size() == 9 && P.size() == 12 && R.size() == 9)
+                {
+                    for (size_t i = 0; i < 9; ++i)
+                        _camera_info[stream_index].k.at(i) = K[i];
+                    for (size_t i = 0; i < 12; ++i)
+                        _camera_info[stream_index].p.at(i) = P[i];
+                    for (size_t i = 0; i < 9; ++i)
+                        _camera_info[stream_index].r.at(i) = R[i];
+                    _camera_info[stream_index].d.assign(D.begin(), D.end());
+                    _camera_info[stream_index].distortion_model = model;
+                    ROS_INFO_STREAM("Loaded calibrated intrinsics for stream '"
+                        << stream_name << "' from " << path
+                        << " (fx=" << K[0] << ", fy=" << K[4]
+                        << ", cx=" << K[2] << ", cy=" << K[5] << ")");
+                }
+                else
+                {
+                    ROS_WARN_STREAM("camera_info_url YAML at " << path
+                        << " has unexpected matrix sizes - using FIRMWARE intrinsics.");
+                }
+            }
+        }
+        catch (const std::exception& e)
+        {
+            ROS_WARN_STREAM("Failed to load camera_info_url '" << camera_info_url
+                << "' for stream '" << stream_name << "': " << e.what()
+                << " - using FIRMWARE intrinsics.");
+        }
+    }
+    // ---- end PATCH ----
 }
 
 void BaseRealSenseNode::updateExtrinsicsCalibData(const rs2::video_stream_profile& left_video_profile, const rs2::video_stream_profile& right_video_profile)
