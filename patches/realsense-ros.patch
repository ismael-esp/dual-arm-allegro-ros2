diff --git a/cam_tf_tuner.py b/cam_tf_tuner.py
new file mode 100644
index 00000000..c44ab02b
--- /dev/null
+++ b/cam_tf_tuner.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""
+cam_tf_tuner.py
+
+Interactive static TF tuner. Publishes a parent->child transform whose 6-DOF
+pose is controlled live by ROS parameters (x, y, z, roll, pitch, yaw).
+
+Use this to manually polish a hand-eye calibration result when the solver has
+plateaued at its systematic floor.
+
+Workflow:
+    1. Stop the existing static_transform_publisher for the same frame pair
+       (e.g. comment out cam2_tf_node in start_torso_config.launch.py).
+    2. Launch the rest of the system normally.
+    3. Run this node, defaulting to your current calibration values:
+          ros2 run easy_handeye2 cam_tf_tuner.py
+    4. Tweak parameters live in another terminal:
+          ros2 param set /cam_tf_tuner pitch 0.005
+       Watch the point cloud realign with the URDF in RViz.
+    5. Verify quantitatively each step:
+          ros2 run easy_handeye2 table_tilt.py
+    6. When tilt is below your target (~0.3 deg), the script logs the final
+       values formatted ready to paste back into your launch file.
+
+Tweak granularity reference (rotation):
+       0.1 deg = 0.00175 rad
+       0.5 deg = 0.00873 rad
+       1.0 deg = 0.01745 rad
+"""
+import math
+import rclpy
+from rclpy.node import Node
+from rcl_interfaces.msg import SetParametersResult
+from geometry_msgs.msg import TransformStamped
+import tf2_ros
+
+
+def rpy_to_quat(roll, pitch, yaw):
+    """ZYX (yaw-pitch-roll) Euler -> quaternion (xyzw). Matches tf2_echo RPY."""
+    cy, sy = math.cos(yaw * 0.5), math.sin(yaw * 0.5)
+    cp, sp = math.cos(pitch * 0.5), math.sin(pitch * 0.5)
+    cr, sr = math.cos(roll * 0.5), math.sin(roll * 0.5)
+    return (
+        sr * cp * cy - cr * sp * sy,
+        cr * sp * cy + sr * cp * sy,
+        cr * cp * sy - sr * sp * cy,
+        cr * cp * cy + sr * sp * sy,
+    )
+
+
+PARAM_NAMES = ('parent_frame', 'child_frame',
+               'x', 'y', 'z', 'roll', 'pitch', 'yaw')
+
+
+class CamTFTuner(Node):
+    def __init__(self):
+        super().__init__('cam_tf_tuner')
+        # Defaults = ra_base_link -> cam2_link from last hand-eye calibration.
+        # Override any of these at launch with --ros-args -p name:=value.
+        self.declare_parameter('parent_frame', 'ra_base_link')
+        self.declare_parameter('child_frame',  'cam2_link')
+        self.declare_parameter('x',      0.282625)
+        self.declare_parameter('y',      1.189474)
+        self.declare_parameter('z',      0.555863)
+        self.declare_parameter('roll',   2.742)
+        self.declare_parameter('pitch', -0.004)
+        self.declare_parameter('yaw',   -1.347)
+
+        self.bcaster = tf2_ros.StaticTransformBroadcaster(self)
+        self.last_snapshot = None
+        self.add_on_set_parameters_callback(self.on_param_change)
+
+        # Publish once now, then re-check at 5 Hz; publish only on change.
+        self.publish_tf(log=True)
+        self.create_timer(0.2, self.tick)
+
+    def on_param_change(self, params):
+        # Accept all valid value changes - publish happens in tick().
+        return SetParametersResult(successful=True)
+
+    def snapshot(self):
+        return tuple(self.get_parameter(n).value for n in PARAM_NAMES)
+
+    def tick(self):
+        cur = self.snapshot()
+        if cur != self.last_snapshot:
+            self.publish_tf(log=True)
+            self.last_snapshot = cur
+
+    def publish_tf(self, log):
+        p = lambda n: self.get_parameter(n).value
+        roll, pitch, yaw = p('roll'), p('pitch'), p('yaw')
+        qx, qy, qz, qw = rpy_to_quat(roll, pitch, yaw)
+
+        t = TransformStamped()
+        t.header.stamp = self.get_clock().now().to_msg()
+        t.header.frame_id = p('parent_frame')
+        t.child_frame_id  = p('child_frame')
+        t.transform.translation.x = float(p('x'))
+        t.transform.translation.y = float(p('y'))
+        t.transform.translation.z = float(p('z'))
+        t.transform.rotation.x = qx
+        t.transform.rotation.y = qy
+        t.transform.rotation.z = qz
+        t.transform.rotation.w = qw
+        self.bcaster.sendTransform(t)
+
+        if log:
+            self.get_logger().info(
+                "\n=== Current TF (paste these into your launch file) ===\n"
+                f"  {p('parent_frame')} -> {p('child_frame')}\n"
+                f"  --x  {p('x'):+.6f}   --y  {p('y'):+.6f}   --z  {p('z'):+.6f}\n"
+                f"  --qx {qx:+.6f}  --qy {qy:+.6f}  --qz {qz:+.6f}  --qw {qw:+.6f}\n"
+                f"  RPY (rad): roll={roll:+.6f} pitch={pitch:+.6f} yaw={yaw:+.6f}\n"
+                f"  RPY (deg): roll={math.degrees(roll):+.3f} "
+                f"pitch={math.degrees(pitch):+.3f} yaw={math.degrees(yaw):+.3f}")
+
+
+def main():
+    rclpy.init()
+    rclpy.spin(CamTFTuner())
+
+
+if __name__ == '__main__':
+    main()
